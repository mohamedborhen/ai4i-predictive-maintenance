{
  "project": "AI4I 2020 Predictive Maintenance",
  "target": "Machine failure",
  "positive_class": 1,
  "features": [
    "Type",
    "Air temperature [K]",
    "Process temperature [K]",
    "Rotational speed [rpm]",
    "Torque [Nm]",
    "Tool wear [min]"
  ],
  "default_threshold": 0.5,
  "default_model": "Decision Tree",
  "models": [
    {
      "name": "Decision Tree",
      "artifact": "decision_tree.joblib",
      "cross_validated_average_precision": 0.4882314181189038
    },
    {
      "name": "KNN",
      "artifact": "knn.joblib",
      "cross_validated_average_precision": 0.4640313322529862
    }
  ],
  "training_configuration": {
    "sampler_mode": "None",
    "hyperparameter_tuning": false,
    "cross_validation_folds": 5,
    "test_size": 0.2,
    "random_seed": 42
  },
  "runtime_versions": {
    "python": "3.13.15",
    "scikit_learn": "1.6.1",
    "joblib": "1.6.0"
  }
}